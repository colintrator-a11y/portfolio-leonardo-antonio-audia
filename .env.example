# Visit notifier - set these in Vercel → Settings → Environment Variables.
# Never commit real values. The token is a secret: anyone holding it can post
# to your chat, read everything sent to the bot, and re-point it via setWebhook.

# From BotFather.
TELEGRAM_BOT_TOKEN=

# The chat to notify. Message your bot once, then open
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# and copy result[0].message.chat.id
TELEGRAM_CHAT_ID=

# Label shown in the message, so several portfolios can share one bot.
SITE_NAME=Leonardo

# Optional. Comma-separated origins allowed to call /api/notify.
# Defaults to the deployment's own host, which is right for most setups.
# ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Optional. proxycheck.io API key. Without it the function falls back to
# ip-api.com, which is keyless but HTTP-only on its free tier.
# PROXYCHECK_KEY=
