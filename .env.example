# Visit notifications.
#
# The Telegram credentials do NOT live here. They belong to the shared
# portfolio-notifier service, which every portfolio posts to. This project only
# needs to know where that service is.
#
# Set the same variable in Vercel → Settings → Environment Variables, then
# redeploy - Vite bakes VITE_* values in at build time, so a running deployment
# will not pick up a change until it is rebuilt.
#
# Leave it unset and the portfolio simply sends nothing.

VITE_NOTIFY_URL=https://your-notifier-project.vercel.app/api/notify
